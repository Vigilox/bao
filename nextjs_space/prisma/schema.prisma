generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/bao/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// Authentication
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
  
  // UGC Social Features
  profile           CreatorProfile?
  posts             Post[]
  likes             Like[]
  comments          Comment[]
  savedPosts        SavedPost[]
  following         Follow[]         @relation("follower")
  followers         Follow[]         @relation("following")
  notifications     Notification[]   @relation("recipient")
  triggeredNotifs   Notification[]   @relation("actor")

  @@map("users")
}

// Creator Profile for UGC
model CreatorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  username      String   @unique
  displayName   String?
  bio           String?  @db.Text
  avatarUrl     String?
  bannerUrl     String?
  website       String?
  location      String?
  socialLinks   Json?    // { twitter, instagram, youtube, tiktok, etc. }
  isVerified    Boolean  @default(false)
  isPublic      Boolean  @default(true)
  totalViews    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
  @@map("creator_profiles")
}

// Published Content Posts
model Post {
  id               String   @id @default(cuid())
  userId           String
  title            String?
  caption          String?  @db.Text
  mediaType        String   // 'image', 'video'
  mediaUrl         String
  thumbnailUrl     String?
  cloudStoragePath String?
  prompt           String?  @db.Text
  modelUsed        String?  // 'nano-banana', 'veo3', 'sora2', etc.
  aspectRatio      String?
  duration         Float?   // For videos, in seconds
  tags             String[] @default([])
  isPublic         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  featuredAt       DateTime? // When it was featured
  viewCount        Int      @default(0)
  trendingScore    Float    @default(0) // Calculated trending score
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]
  comments  Comment[]
  savedBy   SavedPost[]
  postTags  PostTag[]

  @@index([userId])
  @@index([isPublic, createdAt])
  @@index([isFeatured])
  @@index([trendingScore(sort: Desc)])
  @@map("posts")
}

// Tags for content categorization
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  // Hex color for UI
  icon        String?  // Icon name
  postCount   Int      @default(0)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts PostTag[]

  @@index([slug])
  @@index([postCount(sort: Desc)])
  @@map("tags")
}

// Junction table for Post-Tag many-to-many
model PostTag {
  id        String   @id @default(cuid())
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// Likes on Posts
model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

// Comments on Posts
model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String   @db.Text
  parentId  String?  // For nested replies
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

// Saved/Bookmarked Posts
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("saved_posts")
}

// Follow Relationships
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String   // Recipient
  actorId   String?  // Who triggered it
  type      String   // 'like', 'comment', 'follow', 'mention', 'feature'
  postId    String?  // Related post if applicable
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Core Application Models
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes           Scene[]
  documents        Document[]
  chatMessages     ChatMessage[]
  generationTasks  GenerationTask[]
  assets           Asset[]
  artboards        Artboard[]
  artboardSnapshots ArtboardSnapshot[]

  @@index([userId])
  @@map("projects")
}

model Scene {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots   Shot[]

  @@index([projectId])
  @@map("scenes")
}

model Shot {
  id          String   @id @default(cuid())
  sceneId     String
  prompt      String   @db.Text
  assetUrl    String?
  assetType   String?  // 'image' or 'video'
  modelUsed   String?
  metadata    Json?    // Store generation parameters, dimensions, etc.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scene           Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  generationTasks GenerationTask[]

  @@index([sceneId])
  @@map("shots")
}

model Asset {
  id               String   @id @default(cuid())
  projectId        String
  filename         String
  assetType        String   // 'image', 'video', 'reference'
  cloudStoragePath String
  isPublic         Boolean  @default(false)
  url              String?  // Cached URL for display
  thumbnailUrl     String?
  prompt           String?  @db.Text
  modelUsed        String?
  metadata         Json?    // Dimensions, duration, file size, etc.
  tags             String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assetType])
  @@map("assets")
}

model Document {
  id               String                       @id @default(cuid())
  projectId        String
  filename         String
  cloudStoragePath String
  isPublic         Boolean                      @default(false)
  contentType      String                       // 'script', 'brand_guidelines', 'reference', etc.
  extractedText    String?                      @db.Text
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentChunks DocumentChunk[]

  @@index([projectId])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String   @db.Text
  embedding  Json?    // Store embedding as JSON array [float, float, ...]
  metadata   Json?    // Store chunk position, page number, etc.
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String   // 'user', 'assistant', 'system'
  content   String   @db.Text
  metadata  Json?    // Store referenced assets, generation requests, etc.
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("chat_messages")
}

model GenerationTask {
  id         String   @id @default(cuid())
  projectId  String
  shotId     String?
  taskId     String   // Kie.AI task ID
  status     String   // 'pending', 'processing', 'completed', 'failed'
  model      String   // 'nano-banana', 'veo3', etc.
  taskType   String   // 'image', 'video', 'image_edit'
  parameters Json     // Store all generation parameters
  resultUrl  String?
  errorMsg   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shot    Shot?   @relation(fields: [shotId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@map("generation_tasks")
}

// Design Tool Models
model Artboard {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  widthPx     Int      @default(800)
  heightPx    Int      @default(600)
  data        Json     // Canvas objects state
  templateId  String?  // Reference to template if created from one
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template      Template?              @relation(fields: [templateId], references: [id], onDelete: SetNull)
  snapshots     ArtboardSnapshot[]
  collaborators ArtboardCollaborator[]

  @@index([projectId])
  @@index([templateId])
  @@map("artboards")
}

model ArtboardSnapshot {
  id         String   @id @default(cuid())
  artboardId String
  projectId  String
  name       String
  data       Json     // Snapshot of canvas state
  createdAt  DateTime @default(now())

  artboard Artboard @relation(fields: [artboardId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([artboardId])
  @@index([projectId])
  @@map("artboard_snapshots")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  category    String   // 'social-media', 'banner', 'business-card', 'flyer', 'poster', etc.
  widthPx     Int
  heightPx    Int
  thumbnailUrl String?
  data        Json     // Default canvas objects
  tags        String[] @default([])
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artboards Artboard[]

  @@index([category])
  @@map("templates")
}

model ArtboardCollaborator {
  id          String   @id @default(cuid())
  artboardId  String
  userId      String
  userName    String
  userEmail   String
  color       String   // Hex color for cursor
  cursorX     Float?
  cursorY     Float?
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())

  artboard Artboard @relation(fields: [artboardId], references: [id], onDelete: Cascade)

  @@unique([artboardId, userId])
  @@index([artboardId])
  @@index([userId])
  @@map("artboard_collaborators")
}
