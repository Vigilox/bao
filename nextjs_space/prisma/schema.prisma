generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/bao/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// User roles enum
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// Authentication
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String
  image         String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]
  
  // UGC Social Features
  profile           CreatorProfile?
  posts             Post[]
  likes             Like[]
  comments          Comment[]
  savedPosts        SavedPost[]
  following         Follow[]         @relation("follower")
  followers         Follow[]         @relation("following")
  notifications     Notification[]   @relation("recipient")
  triggeredNotifs   Notification[]   @relation("actor")
  
  // Monetization
  tipsSent          Tip[]
  transactions      Transaction[]
  withdrawals       Withdrawal[]
  contentPurchases  ContentPurchase[]
  
  // Community Features
  sentMessages      DirectMessage[]       @relation("sentMessages")
  receivedMessages  DirectMessage[]       @relation("receivedMessages")
  conversations1    Conversation[]        @relation("conversations1")
  conversations2    Conversation[]        @relation("conversations2")
  challengeSubmissions ChallengeSubmission[] @relation("challengeSubmissions")
  forumThreads      ForumThread[]         @relation("forumThreads")
  forumReplies      ForumReply[]          @relation("forumReplies")

  @@map("users")
}

// Creator Profile for UGC
model CreatorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  username      String   @unique
  displayName   String?
  bio           String?  @db.Text
  avatarUrl     String?
  bannerUrl     String?
  website       String?
  location      String?
  socialLinks   Json?    // { twitter, instagram, youtube, tiktok, etc. }
  isVerified    Boolean  @default(false)
  isPublic      Boolean  @default(true)
  totalViews    Int      @default(0)
  // Monetization fields
  acceptsTips       Boolean  @default(false)
  minimumTip        Float    @default(1.0) // Minimum tip amount in USD
  tipMessage        String?  @db.Text // Custom message for tip button
  totalEarnings     Float    @default(0) // Lifetime earnings
  availableBalance  Float    @default(0) // Available for withdrawal
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeAccount  StripeConnectAccount?
  tipsReceived   Tip[]                 @relation("tipRecipient")
  analytics      CreatorAnalytics[]

  @@index([username])
  @@map("creator_profiles")
}

// Published Content Posts
model Post {
  id               String   @id @default(cuid())
  userId           String
  title            String?
  caption          String?  @db.Text
  mediaType        String   // 'image', 'video'
  mediaUrl         String
  thumbnailUrl     String?
  cloudStoragePath String?
  prompt           String?  @db.Text
  modelUsed        String?  // 'nano-banana', 'veo3', 'sora2', etc.
  aspectRatio      String?
  duration         Float?   // For videos, in seconds
  tags             String[] @default([])
  isPublic         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  featuredAt       DateTime? // When it was featured
  viewCount        Int      @default(0)
  trendingScore    Float    @default(0) // Calculated trending score
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes             Like[]
  comments          Comment[]
  savedBy           SavedPost[]
  postTags          PostTag[]
  tips              Tip[]
  premiumContent    PremiumContent?
  analytics         PostAnalytics?
  challengeSubmission ChallengeSubmission?

  @@index([userId])
  @@index([isPublic, createdAt])
  @@index([isFeatured])
  @@index([trendingScore(sort: Desc)])
  @@map("posts")
}

// Tags for content categorization
model Tag {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  color       String?  // Hex color for UI
  icon        String?  // Icon name
  postCount   Int      @default(0)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts PostTag[]

  @@index([slug])
  @@index([postCount(sort: Desc)])
  @@map("tags")
}

// Junction table for Post-Tag many-to-many
model PostTag {
  id        String   @id @default(cuid())
  postId    String
  tagId     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// Likes on Posts
model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

// Comments on Posts
model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String   @db.Text
  parentId  String?  // For nested replies
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

// Saved/Bookmarked Posts
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@map("saved_posts")
}

// Follow Relationships
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// Notifications
model Notification {
  id        String   @id @default(cuid())
  userId    String   // Recipient
  actorId   String?  // Who triggered it
  type      String   // 'like', 'comment', 'follow', 'mention', 'feature'
  postId    String?  // Related post if applicable
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Core Application Models
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenes           Scene[]
  documents        Document[]
  chatMessages     ChatMessage[]
  generationTasks  GenerationTask[]
  assets           Asset[]
  artboards        Artboard[]
  artboardSnapshots ArtboardSnapshot[]

  @@index([userId])
  @@map("projects")
}

model Scene {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  order       Int      @default(0)
  projectId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shots   Shot[]

  @@index([projectId])
  @@map("scenes")
}

model Shot {
  id          String   @id @default(cuid())
  sceneId     String
  prompt      String   @db.Text
  assetUrl    String?
  assetType   String?  // 'image' or 'video'
  modelUsed   String?
  metadata    Json?    // Store generation parameters, dimensions, etc.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scene           Scene            @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  generationTasks GenerationTask[]

  @@index([sceneId])
  @@map("shots")
}

model Asset {
  id               String   @id @default(cuid())
  projectId        String
  filename         String
  assetType        String   // 'image', 'video', 'reference'
  cloudStoragePath String
  isPublic         Boolean  @default(false)
  url              String?  // Cached URL for display
  thumbnailUrl     String?
  prompt           String?  @db.Text
  modelUsed        String?
  metadata         Json?    // Dimensions, duration, file size, etc.
  tags             String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([assetType])
  @@map("assets")
}

model Document {
  id               String                       @id @default(cuid())
  projectId        String
  filename         String
  cloudStoragePath String
  isPublic         Boolean                      @default(false)
  contentType      String                       // 'script', 'brand_guidelines', 'reference', etc.
  extractedText    String?                      @db.Text
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentChunks DocumentChunk[]

  @@index([projectId])
  @@map("documents")
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  content    String   @db.Text
  embedding  Json?    // Store embedding as JSON array [float, float, ...]
  metadata   Json?    // Store chunk position, page number, etc.
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_chunks")
}

model ChatMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String   // 'user', 'assistant', 'system'
  content   String   @db.Text
  metadata  Json?    // Store referenced assets, generation requests, etc.
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("chat_messages")
}

model GenerationTask {
  id         String   @id @default(cuid())
  projectId  String
  shotId     String?
  taskId     String   // Kie.AI task ID
  status     String   // 'pending', 'processing', 'completed', 'failed'
  model      String   // 'nano-banana', 'veo3', etc.
  taskType   String   // 'image', 'video', 'image_edit'
  parameters Json     // Store all generation parameters
  resultUrl  String?
  errorMsg   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  shot    Shot?   @relation(fields: [shotId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@map("generation_tasks")
}

// Design Tool Models
model Artboard {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?  @db.Text
  widthPx     Int      @default(800)
  heightPx    Int      @default(600)
  data        Json     // Canvas objects state
  templateId  String?  // Reference to template if created from one
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  template      Template?              @relation(fields: [templateId], references: [id], onDelete: SetNull)
  snapshots     ArtboardSnapshot[]
  collaborators ArtboardCollaborator[]
  effects       DesignEffect[]
  animations    DesignAnimation[]

  @@index([projectId])
  @@index([templateId])
  @@map("artboards")
}

model ArtboardSnapshot {
  id         String   @id @default(cuid())
  artboardId String
  projectId  String
  name       String
  data       Json     // Snapshot of canvas state
  createdAt  DateTime @default(now())

  artboard Artboard @relation(fields: [artboardId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([artboardId])
  @@index([projectId])
  @@map("artboard_snapshots")
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  category    String   // 'social-media', 'banner', 'business-card', 'flyer', 'poster', etc.
  widthPx     Int
  heightPx    Int
  thumbnailUrl String?
  data        Json     // Default canvas objects
  tags        String[] @default([])
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artboards Artboard[]

  @@index([category])
  @@map("templates")
}

model ArtboardCollaborator {
  id          String   @id @default(cuid())
  artboardId  String
  userId      String
  userName    String
  userEmail   String
  color       String   // Hex color for cursor
  cursorX     Float?
  cursorY     Float?
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())

  artboard Artboard @relation(fields: [artboardId], references: [id], onDelete: Cascade)

  @@unique([artboardId, userId])
  @@index([artboardId])
  @@index([userId])
  @@map("artboard_collaborators")
}

// Design Effects (filters, shadows, blur, etc.)
model DesignEffect {
  id          String   @id @default(cuid())
  artboardId  String
  objectId    String   // Fabric.js object ID
  effectType  String   // 'filter', 'shadow', 'blur', 'glow', 'outline'
  properties  Json     // Effect-specific properties
  isEnabled   Boolean  @default(true)
  order       Int      @default(0) // For stacking effects
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artboard Artboard @relation(fields: [artboardId], references: [id], onDelete: Cascade)

  @@index([artboardId])
  @@index([objectId])
  @@map("design_effects")
}

// Animation presets and keyframes
model DesignAnimation {
  id          String   @id @default(cuid())
  artboardId  String
  objectId    String   // Fabric.js object ID
  name        String   // Animation name
  animationType String // 'fade', 'slide', 'rotate', 'scale', 'bounce', 'custom'
  duration    Int      @default(1000) // Duration in milliseconds
  delay       Int      @default(0)
  easing      String   @default("ease-in-out") // CSS easing function
  iterations  Int      @default(1) // 0 for infinite
  keyframes   Json     // Array of keyframe objects
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  artboard Artboard @relation(fields: [artboardId], references: [id], onDelete: Cascade)

  @@index([artboardId])
  @@index([objectId])
  @@map("design_animations")
}

// ==========================================
// MONETIZATION MODELS
// ==========================================

// Stripe Connect Account Status
enum StripeAccountStatus {
  PENDING      // Not yet onboarded
  ONBOARDING   // In the process of onboarding
  ACTIVE       // Fully active, can receive payouts
  RESTRICTED   // Account has restrictions
  DISABLED     // Account disabled
}

// Stripe Connect Account for Creator Payouts
model StripeConnectAccount {
  id                   String              @id @default(cuid())
  creatorProfileId     String              @unique
  stripeAccountId      String              @unique // Stripe's acct_xxx ID
  status               StripeAccountStatus @default(PENDING)
  chargesEnabled       Boolean             @default(false)
  payoutsEnabled       Boolean             @default(false)
  detailsSubmitted     Boolean             @default(false)
  defaultCurrency      String              @default("usd")
  country              String?
  email                String?
  businessType         String?             // individual, company
  onboardingCompletedAt DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
  @@map("stripe_connect_accounts")
}

// Transaction Type
enum TransactionType {
  TIP           // Tip/donation from supporter
  PREMIUM       // Premium content purchase
  SUBSCRIPTION  // Future: subscription payment
  PAYOUT        // Payout to creator
  REFUND        // Refund
  PLATFORM_FEE  // Platform fee deduction
}

// Transaction Status
enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

// Tips/Donations to Creators
model Tip {
  id                  String            @id @default(cuid())
  recipientProfileId  String
  senderUserId        String?           // Nullable for anonymous tips
  postId              String?           // Optional: tip for specific content
  amount              Float             // Amount in USD
  currency            String            @default("usd")
  platformFee         Float             @default(0) // Platform's cut
  creatorAmount       Float             // Amount creator receives
  message             String?           @db.Text // Optional message from tipper
  isAnonymous         Boolean           @default(false)
  stripePaymentIntentId String?         @unique
  status              TransactionStatus @default(PENDING)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  recipientProfile CreatorProfile @relation("tipRecipient", fields: [recipientProfileId], references: [id], onDelete: Cascade)
  senderUser       User?          @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  post             Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([recipientProfileId])
  @@index([senderUserId])
  @@index([status])
  @@index([createdAt])
  @@map("tips")
}

// Platform Transactions Ledger
model Transaction {
  id               String            @id @default(cuid())
  userId           String
  type             TransactionType
  amount           Float
  currency         String            @default("usd")
  status           TransactionStatus @default(PENDING)
  description      String?
  referenceId      String?           // Reference to tip, premium content, etc.
  stripePaymentId  String?           // Stripe payment intent or transfer ID
  metadata         Json?             // Additional data
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// Creator Withdrawals/Payouts
model Withdrawal {
  id                   String            @id @default(cuid())
  userId               String
  amount               Float
  currency             String            @default("usd")
  status               TransactionStatus @default(PENDING)
  stripeTransferId     String?
  stripePayoutId       String?
  destinationAccountId String?           // Stripe Connect account ID
  failureReason        String?
  processedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("withdrawals")
}

// Premium Content for Monetization
model PremiumContent {
  id               String   @id @default(cuid())
  postId           String   @unique
  price            Float    // Price in USD
  currency         String   @default("usd")
  previewMediaUrl  String?  // Free preview
  isActive         Boolean  @default(true)
  totalPurchases   Int      @default(0)
  totalRevenue     Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  purchases ContentPurchase[]

  @@index([isActive])
  @@map("premium_content")
}

// Purchases of Premium Content
model ContentPurchase {
  id                    String            @id @default(cuid())
  userId                String
  premiumContentId      String
  amount                Float
  currency              String            @default("usd")
  stripePaymentIntentId String?           @unique
  status                TransactionStatus @default(PENDING)
  createdAt             DateTime          @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  premiumContent PremiumContent @relation(fields: [premiumContentId], references: [id], onDelete: Cascade)

  @@unique([userId, premiumContentId])
  @@index([userId])
  @@index([premiumContentId])
  @@map("content_purchases")
}

// ==========================================
// ANALYTICS MODELS
// ==========================================

// Track post views, likes, and engagement
model PostAnalytics {
  id                String   @id @default(cuid())
  postId            String   @unique
  views             Int      @default(0)
  uniqueViews       Int      @default(0)
  likes             Int      @default(0)
  comments          Int      @default(0)
  shares            Int      @default(0)
  avgWatchTime      Float?   // For videos, in seconds
  engagementRate    Float    @default(0) // Calculated: (likes + comments + shares) / views
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_analytics")
}

// Track creator profile analytics
model CreatorAnalytics {
  id                  String   @id @default(cuid())
  creatorProfileId    String   @unique
  date                DateTime @default(now()) @db.Date
  profileViews        Int      @default(0)
  newFollowers        Int      @default(0)
  totalFollowers      Int      @default(0)
  totalLikes          Int      @default(0)
  totalComments       Int      @default(0)
  totalPosts          Int      @default(0)
  totalVideoViews     Int      @default(0)
  totalImageViews     Int      @default(0)
  engagementRate      Float    @default(0)
  audienceDemographics Json?   // { ageGroups, locations, interests }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)

  @@unique([creatorProfileId, date])
  @@index([creatorProfileId])
  @@index([date])
  @@map("creator_analytics")
}

// ==========================================
// COMMUNITY FEATURES
// ==========================================

// Direct Messages
enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

model DirectMessage {
  id             String        @id @default(cuid())
  conversationId String
  senderId       String
  receiverId     String
  content        String        @db.Text
  mediaUrl       String?
  mediaType      String?       // 'image', 'video', 'file'
  status         MessageStatus @default(SENT)
  isEdited       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver     User         @relation("receivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("direct_messages")
}

model Conversation {
  id              String   @id @default(cuid())
  participant1Id  String
  participant2Id  String
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participant1 User            @relation("conversations1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2 User            @relation("conversations2", fields: [participant2Id], references: [id], onDelete: Cascade)
  messages     DirectMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
  @@map("conversations")
}

// Creator Challenges
enum ChallengeStatus {
  UPCOMING
  ACTIVE
  ENDED
  ARCHIVED
}

model Challenge {
  id            String          @id @default(cuid())
  title         String
  description   String          @db.Text
  coverImageUrl String?
  rules         String          @db.Text
  prize         String?
  startDate     DateTime
  endDate       DateTime
  status        ChallengeStatus @default(UPCOMING)
  maxSubmissions Int?           // Limit per user
  totalSubmissions Int          @default(0)
  totalParticipants Int         @default(0)
  createdBy     String?         // Admin who created it
  tags          String[]        @default([])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  submissions ChallengeSubmission[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("challenges")
}

model ChallengeSubmission {
  id            String   @id @default(cuid())
  challengeId   String
  userId        String
  postId        String   @unique
  votes         Int      @default(0)
  isWinner      Boolean  @default(false)
  createdAt     DateTime @default(now())

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation("challengeSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, postId])
  @@index([challengeId])
  @@index([userId])
  @@index([postId])
  @@map("challenge_submissions")
}

// Community Forums
enum ForumCategory {
  GENERAL
  TUTORIALS
  FEEDBACK
  SHOWCASE
  HELP
  ANNOUNCEMENTS
}

model ForumThread {
  id            String        @id @default(cuid())
  title         String
  content       String        @db.Text
  category      ForumCategory @default(GENERAL)
  authorId      String
  isPinned      Boolean       @default(false)
  isLocked      Boolean       @default(false)
  views         Int           @default(0)
  totalReplies  Int           @default(0)
  lastReplyAt   DateTime?
  tags          String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  author  User              @relation("forumThreads", fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([authorId])
  @@index([category])
  @@index([isPinned])
  @@map("forum_threads")
}

model ForumReply {
  id         String   @id @default(cuid())
  threadId   String
  authorId   String
  content    String   @db.Text
  isEdited   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  thread ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User        @relation("forumReplies", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([authorId])
  @@map("forum_replies")
}
